# Copy to .env and fill in. .env itself is gitignored — never commit it.
#
# These are the publishable (anon) credentials. They are safe to ship in the
# client bundle because access is governed by RLS, not by keeping them secret.
# Service-role / sb_secret_ keys must NEVER appear in this file — they bypass RLS.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
